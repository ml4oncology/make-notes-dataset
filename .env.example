# Cluster configuration for make_notes_dataset.
#
# Copy this file to .env and fill in your cluster values.
# .env is gitignored, so these real paths never enter version control.
# The bash scripts under scripts/ resolve these variables at runtime.

# SLURM username passed to pySLURMargs.py when submitting jobs
CLUSTER_USERNAME=

# Absolute path to the Python interpreter of your conda environment
CONDA_PYTHON=

# Root directory containing the raw data pulls (data_pull_<date>/...)
RAW_DATA_BASE=

# Root directory containing the processed clinical notes
PROCESSED_DATA_BASE=

# Apptainer image used by the de-identification pipeline
DEID_CONTAINER_PATH=

# Pretrained de-identification model directory
DEID_MODEL_PATH=

# DeID config file from the robust_deid package
DEID_CONFIG_FILE=

# Directory containing the MRN mapping CSVs (used by process_notes.sh)
MRN_MAP_DIR=